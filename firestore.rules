rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && (data.get('description', '') is string && data.get('description', '').size() <= 10000)
        && (data.get('courseCode', '') is string && data.get('courseCode', '').size() <= 50)
        && (data.get('courseName', '') is string && data.get('courseName', '').size() <= 100)
        && (data.get('dueDate', '') is string && data.get('dueDate', '').size() <= 50)
        && (data.get('estimatedMinutes', 0) is number)
        && (data.get('priority', 'low') in ['low', 'medium', 'high'])
        && (data.get('status', 'pending') in ['pending', 'in-progress', 'completed'])
        && (data.get('source', 'manual') in ['brightspace', 'manual'])
        && (data.get('brightspaceType', 'other') in ['assignment', 'quiz', 'exam', 'reading', 'lab', 'discussion', 'other'])
        && (data.get('brightspaceUrl', '') is string && data.get('brightspaceUrl', '').size() <= 1000)
        && (data.get('createdAt', '') is string && data.get('createdAt', '').size() <= 50)
        && (data.get('updatedAt', '') is string && data.get('updatedAt', '').size() <= 50)
        && (data.get('completedAt', '') is string && data.get('completedAt', '').size() <= 50)
        && (data.get('reminders', []) is list && data.get('reminders', []).size() <= 10);
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().userId == request.auth.uid;

      allow update: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().userId == request.auth.uid
        && existing().userId == request.auth.uid
        && incoming().createdAt == existing().createdAt;

      allow delete: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(taskId)
        && existing().userId == request.auth.uid;
    }
  }
}
